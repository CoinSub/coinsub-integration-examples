# =============================================================================
# Coinsub API Configuration
# =============================================================================

# Your Coinsub API Key - Required for all API calls
# Get this from: https://app.coinsub.io/merchant/profile/apikeys
# Format: UUID (e.g., 00ed9815-eb98-43df-9743-c6e6fa48be06)
COINSUB_API_KEY=your-api-key-here

# Your Coinsub Merchant ID - Required for all API calls
# Get this from: https://app.coinsub.io/merchant/profile/apikeys (same page as API key)
# Format: UUID (e.g., 10d3ed3c-2471-4573-ac66-ec7e3b414e80)
COINSUB_MERCHANT_ID=your-merchant-id-here

# Webhook Secret - Optional for local development, Required for production
# Get this from your Coinsub dashboard when configuring webhooks
# Used to verify webhook signatures for security
COINSUB_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# Environment Configuration
# =============================================================================

# Environment mode: "test" for development, "production" for live
# Test mode uses: https://test-api.coinsub.io
# Production mode uses: https://api.coinsub.io
COINSUB_ENV=test

# =============================================================================
# Flask Server Configuration
# =============================================================================

# Port for the Flask backend server
# Default: 5001 (5000 is often used by macOS AirPlay Receiver)
PORT=5001

# Enable Flask debug mode (true/false)
# Set to false in production
FLASK_DEBUG=true
