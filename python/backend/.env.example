# Coinsub Integration Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Coinsub API Configuration
# =============================================================================

# Your Coinsub API Key (REQUIRED)
# Get this from: https://test.coinsub.io/settings/api-keys (test)
#            or: https://app.coinsub.io/settings/api-keys (production)
COINSUB_API_KEY=your-api-key-here

# Webhook secret for verifying incoming webhooks (PRODUCTION / NGROK ONLY)
# This is only needed when receiving webhooks from Coinsub.
# For local development without webhooks, you can leave this empty.
# For local testing with ngrok, configure your webhook URL in the dashboard
# and copy the secret here.
COINSUB_WEBHOOK_SECRET=

# Environment: "test" or "production"
# Use "test" during development (connects to test.coinsub.io)
# Use "production" for live payments (connects to app.coinsub.io)
COINSUB_ENV=test

# =============================================================================
# Server Configuration
# =============================================================================

# Port to run the Flask server on
PORT=5000

# Enable debug mode (disable in production!)
FLASK_DEBUG=true
